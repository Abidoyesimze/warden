# Copy to .env (repo root) and fill in. Never commit the real file.
# Shared by agent/ and backend/. The frontend has its own frontend/.env with public values only.

# --- NEAR ---
NEAR_NETWORK=mainnet
# rpc.mainnet.near.org / rpc.testnet.near.org are deprecated and rate-limited;
# FastNEAR is the NEAR-docs-recommended replacement. For testnet dev, use
# https://test.rpc.fastnear.com instead.
NEAR_RPC_URL=https://free.rpc.fastnear.com
TREASURY_CONTRACT_ID=warden.example.near
AGENT_ACCOUNT_ID=warden-agent.example.near
# Function-call access key for the agent account (NEVER a full-access key)
AGENT_PRIVATE_KEY=ed25519:REPLACE_ME
OWNER_ACCOUNT_ID=warden-owner.example.near
# USDC on NEAR, from 1Click GET /v0/tokens (assetId nep141:<this>)
USDC_TOKEN_ID=17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1

# --- NEAR AI Cloud (used by agent/) ---
NEAR_AI_API_KEY=REPLACE_ME
# TEE-hosted, attested model from GET https://cloud-api.near.ai/v1/model/list
NEAR_AI_MODEL=Qwen/Qwen3.6-35B-A3B-FP8

# --- 1Click / NEAR Intents (used by backend/) ---
ONECLICK_BASE_URL=https://1click.chaindefuser.com
ONECLICK_JWT=REPLACE_ME
WARDEN_FEE_BPS=0

# --- Storage ---
DB_PATH=./data/warden.sqlite
PORT=4000
