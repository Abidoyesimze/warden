# Public values only. No secrets in the web app.
# true = serve the UI from fixture data (no backend or wallet needed)
NEXT_PUBLIC_DEMO_MODE=true
# Where the Warden backend runs. The browser never calls it directly: Next.js
# forwards /backend/* to this address (see next.config.ts), so no CORS is needed.
# Restart `npm run dev` after changing it.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Treasury contract the owner wallet signs against
NEXT_PUBLIC_CONTRACT_ID=warden-treasury-cowry.testnet
# testnet or mainnet
NEXT_PUBLIC_NEAR_NETWORK=testnet
